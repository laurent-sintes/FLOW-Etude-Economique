  "exclusions": {
    "orders": "Déclinaisons particulières de consignation, retours et résolutions commerciales ; à compléter au-delà du cycle commun.",
    "goods-orders": "Douze charges utiles et invariants de prestation spécifiques ; un seul cycle et contrat commun.",
    "transport-orders": "Instructions détaillées et booking autonome de capacité, changements/libération propres.",
    "customs": "Dossier douanier, pièces, autorisations et résultat reconnus ; ni moteur réglementaire ni téléprocédure.",
    "financial-services": "Éligibilité des factures/avoirs et rapprochements d’encaissements/remboursements ; pas fiscalité ni banque.",
    "workflow": "Composition réactive contextuelle avancée et garanties non appariées ; aucun modeleur graphique universel.",
    "human-work": "Expérience utilisateur métier et règles d’affectation/calendrier spécifiques non déduites du seul moteur.",
    "supervision": "Vues métier transversales et garanties de volumétrie/historique non appariées.",
    "coordination": "Décisions métier de dépendances, adaptation de promesse et regroupements/libérations ; distinctes de l’exécution du moteur.",
    "assurance": "Variantes de preuve/résultat par prestation et restitution métier complète au-delà du protocole commun."
  },
