  "recommendation": {
    "decision": "continuer_cible",
    "worth_another_iteration": true,
    "reason": "Les écarts du stock et l’attribution de certains rôles peuvent modifier la charge et sa valorisation. Des preuves techniques et une règle de responsabilité peuvent résoudre ces causes ; une nouvelle estimation globale seule aurait peu de valeur.",
    "next_objective": "Stabiliser d’abord garanties, livrables et responsabilités, puis éprouver par des prototypes bornés la reprise d’import et la cohérence stock/réservation.",
    "tasks": [
      {
        "task": "Contrat REF et essai de reprise d’un lot",
        "observable": "Fixer champs/types, ordre des relations et sens d’un lot complet ; examiner 10 000 lignes avec parents après variantes, répétitions, conflit de version, interruption après validation partielle puis relance. Absents conservés, pas d’éditeur de mapping."
      },
      {
        "task": "Prototype isolé Spring/PostgreSQL de réservation et répétition",
        "observable": "Physique 10, deux réservations de 7 ; réservé total ≤10, cohérence journal/position/réservation, doublon sans effet, conflit de contenu refusé, reprise après rollback ou réponse perdue. Tester aussi une clé de stock initialement absente."
      },
      {
        "task": "Scénario de consommation/correction/libération",
        "observable": "Physique 10, réservé 6 ; consommation 2 → physique 8, réservé 4 ; compensation −5 refusée atomiquement ; libération puis compensation admissible avec sémantique explicite de nouvelle tentative."
      },
      {
        "task": "Matrice de responsabilités et catalogue QA minimal",
        "observable": "Un propriétaire et un rôle pour chaque travail ; absence de double compte entre préparation locale et campagne transverse ; revue sécurité spécialisée explicitement retenue ou exclue. Décrire les états/actions des cinq vues sans les confondre avec le nombre d’écrans."
      }
    ],
    "stop_condition": "Après ce passage borné, figer le contrat, la règle de maille et les responsabilités, puis éprouver les familles réservées. Si une difficulté demeure, conserver une variante ou une inconnue explicite ; ne pas prolonger jusqu’à produire le logiciel. Réouvrir une charge seulement avec un travail ou une hypothèse modifié et documenté.",
    "avoid": "Ne pas répéter les mêmes recherches ni demander une troisième estimation globale pour fabriquer un consensus.",
    "proof_limit": "Un prototype peut vérifier une garantie et préciser les travaux ; son temps d’exécution par un agent ne constitue pas une productivité humaine ni une calibration des JH.",
    "investigation_bound": "Un passage et au maximum une correction ciblée par prototype ; aucun écran complet, connecteur ou essai de charge de production. Pour chaque question : résultat, mécanisme retenu, travaux ajoutés/retirés/inchangés, incidence argumentée sur les rôles et inconnue restante. Une réussite technique ne suffit pas à réduire la plage de JH."
  },
  "market_method_status": {
    "COSMIC": "Taille fonctionnelle ; témoin limité en itération02, aucun décompte complet du panier ni conversion en JH ici.",
    "COCOMO_II": "Conditions de taille logique, adaptation et calibration non réunies ; aucun JH COCOMO inventé.",
    "ISBSG": "Données empiriques historiques, pas barème Spring par rôle applicable à ce panier.",
    "consequence": "La confrontation numérique des trois références reste incomplète. M1 et M2 sont deux hypothèses d'ingénierie, pas des substituts à cette validation."
  },
