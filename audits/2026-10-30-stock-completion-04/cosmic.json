{
  "status": "comptage_propose_sous_hypotheses_non_adopte",
  "scope": "Huit capacités de la Business Area Inventory State Management. Pas seulement les fragments de code OSS mesurés.",
  "measurement_boundary": "Produit Core System, fonctions Stock ; persistance logique interne, interfaces sources/consommateurs externes. Les appels internes à Master Data ne sont pas décomposés en sous-processus facturés ; les lectures de références nécessaires restent des R sur données persistantes.",
  "source_method": "https://cosmic-sizing.org/wp-content/uploads/2022/11/Combination-of-Parts-v5.0-Sep-2024.pdf",
  "rules_applied": [
    "Un mouvement par type et objet d’intérêt dans un processus, sauf exigence distincte explicite.",
    "Aucune multiplication par lignes, occurrences, pagination, retries ou nombre de serveurs.",
    "Résultats normaux et réponses d’erreur inclus ; contrôles techniques internes non séparés en processus.",
    "Les opérations et algorithmes internes n’augmentent pas seuls les CFP ; leurs contraintes restent dans les hypothèses d’effort."
  ],
  "groups": [
    {
      "id": "FACT",
      "object": "Fait de stock reconnu",
      "attributes": "Identité, produit, lieu, quantité, unité, date du fait et de connaissance, origine, correction liée."
    },
    {
      "id": "BALANCE",
      "object": "État externe de stock",
      "attributes": "Source, périmètre, date, quantités connues et limite de connaissance ; pas de mouvements inventés."
    },
    {
      "id": "LINEAGE",
      "object": "Lien de filiation",
      "attributes": "Biens ou lots source/destination, fait reconnu, quantité et dates."
    },
    {
      "id": "HANDLING",
      "object": "Unité de manutention",
      "attributes": "Identité physique, contenant/contenu communiqués, versions et dates."
    },
    {
      "id": "RESERVATION",
      "object": "Engagement de quantité",
      "attributes": "Besoin, référence de ressource, quantité réservée/consommée/libérée, période et statut."
    },
    {
      "id": "EXPECTED",
      "object": "Apport attendu",
      "attributes": "Référence de commande/plan, quantité, échéance, réalisation, reliquat, fraîcheur."
    },
    {
      "id": "OWNERSHIP",
      "object": "Changement de propriété reconnu",
      "attributes": "Fait détenu par le registre de propriété, sans recalcul de la décision de transfert."
    },
    {
      "id": "POSITION",
      "object": "Position de stock",
      "attributes": "Produit, lieu, propriétaire, détenteur, état, date, quantités présentes/projetées et limites."
    },
    {
      "id": "VERIFICATION",
      "object": "Vérification de stock",
      "attributes": "Périmètre de campagne ou contrôle, protocole, échéance, responsable et statut."
    },
    {
      "id": "COUNT",
      "object": "Constat de comptage",
      "attributes": "Ligne vérification/produit/lieu, quantités attendues/constatées, dates, preuves et écart."
    },
    {
      "id": "CHECK_POLICY",
      "object": "Protocole de vérification",
      "attributes": "Périmètre, campagne/tournant/ponctuel, seuils et règles déclarées ; pas moteur universel."
    },
    {
      "id": "ADJUSTMENT",
      "object": "Décision de correction",
      "attributes": "Autorité, constat justifiant la correction, quantité décidée et lien au fait résultant."
    },
    {
      "id": "PLAN_DATA",
      "object": "Fourniture de positions au plan",
      "attributes": "Périmètre, date, version, données de stock et limites de connaissance."
    },
    {
      "id": "FIN_DATA",
      "object": "Contribution de faits à Finance",
      "attributes": "Faits transmis, justificatifs, version/corrections et état réception/acceptation/rejet."
    },
    {
      "id": "FEEDBACK",
      "object": "Constat produit documenté",
      "attributes": "Produit, contexte, faits connus, preuves, corrections et destinataire ; pas cause inférée."
    },
    {
      "id": "PRODUCT",
      "object": "Référence produit",
      "attributes": "Identité et caractéristiques utiles, déjà sous responsabilité Master Data."
    },
    {
      "id": "SITE",
      "object": "Référence de lieu",
      "attributes": "Identité et périmètre de lieu, déjà sous responsabilité Master Data."
    },
    {
      "id": "PARTY",
      "object": "Référence de partie",
      "attributes": "Identité des propriétaire/détenteur, déjà sous responsabilité Master Data."
    },
    {
      "id": "UNIT",
      "object": "Référence d’unité",
      "attributes": "Unité et conversion déclarée, déjà sous responsabilité Master Data."
    },
    {
      "id": "OUTCOME",
      "object": "Résultat de la demande",
      "attributes": "Acceptation/refus/erreur motivée ; un seul type de sortie de statut par processus."
    }
  ],
  "assumptions": {
    "H01": "Frontière mesurée : fonctionnalités du produit Core System pour Stock, au niveau fonctionnel. Interfaces sources et consommateurs externes sont les utilisateurs fonctionnels. Les raccordements propres à Beaumanoir sont exclus.",
    "H02": "Faits, états externes et corrections portent identité stable, date du fait et date de connaissance. Les projections sont calculées sur demande ; elles ne sont pas un stockage supplémentaire à lire et écrire fictivement.",
    "H03": "Filiations et Handling Units sont des objets reçus explicitement. Leur nombre d’occurrences, profondeur et nombre de lignes ne multiplient pas les mouvements COSMIC.",
    "H04": "Les positions composent faits, états externes, engagements et apports attendus. Les données de propriété/commandes/plans sont supposées fournies par leurs producteurs, sans reconstruire ces capacités.",
    "H05": "Trois modes de vérification combinables, avec protocoles paramétrés et décisions de correction explicites. Le comptage physique reste externe. Création et modification partageant le même résultat fonctionnel ne sont pas artificiellement doublées.",
    "H06": "Consommation et libération sont des commandes métier distinctes de l’admission du fait réalisé. Si elles deviennent de simples étapes internes d’un autre processus, il faut fusionner les processus et recompter. Expiration et libération suivant le même traitement sont réunies.",
    "H07": "Un contrat de fourniture typé par destination : planification, Finance et responsables produit. Les états métier de transmission/acceptation sont conservés ; les accusés techniques et le transport générique ne forment pas des processus supplémentaires."
  },
